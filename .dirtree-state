# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	CODE_REVIEW.md = M2/M3 sequential 13-dimension review findings, dispositions, controls, and dependency follow-ups
	INTENT.md = Canonical project purpose, scope, dependency boundary, constraints, and success evidence
	PLAN.md = Current milestones, review fixes, CI gates, and cross-project sequencing
	TERMINOLOGY.md = Shared RAW container, payload, sample, and metadata definitions
	build.zig = Build graph wiring rawz core, C ABI/CLI, tests, and pinned tiffz module with zlib paths
	build.zig.zon = Zig 0.16 package manifest pinning the tiffz container dependency
	docs/PLAN_LOG.md = Append-only archive of completed PLAN.md items
	docs/RAW_COVERAGE_AND_NOMENCLATURE.md = Fleet RAW coverage/gap matrix + container-vs-payload model + shared nomenclature (validate-authored)
	docs/coverage-evidence/cr2-2026-09-24.md = Records the CC0 EOS 20D CR2 locator proof and jpegz codec blocker.
	docs/coverage-evidence/pef-2026-09-24.md = PEF real and synthetic random-byte/EOF coverage evidence
	docs/coverage-evidence/uncompressed-words-2026-09-24.md = Records D300 uncompressed headroom and mutation coverage evidence.
	docs/plan_context/sensor_data_checks.md = Validate work order for per-variant sensor syntax, depth results, and coverage
	docs/validate_integration.md = Acyclic Validate coordinator, bounded offset contract, and parser-only tiffz requirement
	flake.nix = Reproducible ReleaseFast package and ReleaseSafe tests with fixed-output Zig dependency cache
	include/rawz.h = Stable append-only C status/format enums and borrowed-buffer classification API
	scripts/check-libjxlz-seed = Checks resolved Zig packages for one coherent jpegz-to-libjxlz seed
	src/CAPABILITIES.json = Machine-checked professional RAW family states, production closure, and bounded mutation scorecard
	src/bit_reader.zig = Focused MSB-first in-memory reader for RAW entropy streams
	src/capabilities.zig = Embeds and verifies the RAW capability matrix against executable PEF measurements
	src/classification.zig = Allocation-free Evidence-to-Format policy with one sensitivity/specificity classifier set
	src/cr2_sensor.zig = Locates Canon CR2 raw lossless-JPEG sensor strip with bounded exact offsets.
	src/lib.zig = Pure rawz library/FFI root layered on the imported tiffz container parser
	src/nef_sensor.zig = Locates Nikon CFA SubIFD ranges and distinguishes word versus Huffman payloads.
	src/pef_decoder.zig = Pentax packed-12 and lossless-Huffman validation migrated from validate
	src/sensor_validation.zig = Stable full/structural/fail sensor-validation result domain
	src/tiff_adapter.zig = Bounded tiffz IFD traversal, semantic-tag validation, and stable rawz error mapping
	src/uncompressed_sensor.zig = Validates exact 12/14-bit sensor words, headroom, and optional metadata levels.
	tests/integration/classification.c = Compiled C consumer proving header values, exported symbols, and DNG classification
	tests/integration/libjxlz_seed_control = Set-classifier tests for libjxlz revision, hash, and package-count controls
	tests/production_closure_test = Blocking release gate for parser-only compiler imports, codec-free loader metadata, and smoke-tested shipped binaries
]
